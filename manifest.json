{
  "manifest_version": 3,
  "name": "PopTab",
  "version": "0.1.0",
  "description": "Pop any browser tab into a clean, resizable window, with a hover action for large videos.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    },
    "default_title": "PopTab"
  },
  "permissions": [
    "storage",
    "sessions"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-clean-window": {
      "suggested_key": {
        "default": "Ctrl+Shift+F"
      },
      "description": "Enter or exit clean-window mode for the focused tab"
    },
    "next-clean-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period"
      },
      "description": "Show the next source tab in the focused clean window"
    },
    "previous-clean-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma"
      },
      "description": "Show the previous source tab in the focused clean window"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-float.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
